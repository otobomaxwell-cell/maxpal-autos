# Resend API key used by /api/appointment to email new appointment requests.
# Get one at https://resend.com/api-keys
# Free tier: 100 emails/day, 3,000/month – plenty for this site's volume.
RESEND_API_KEY=

# Verified sending address on Resend (needs a verified domain for reliable
# deliverability in production). Falls back to onboarding@resend.dev if unset,
# which is fine for testing but not for going live.
RESEND_FROM_EMAIL=

# Production domain, once deployed. Used for canonical URLs and OG tags.
# Falls back to http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=

# Where appointment-request emails are sent. Falls back to info@maxpal.co.uk
# (src/lib/business.ts) if unset.
BUSINESS_NOTIFICATION_EMAIL=
